{
  "name": "ever-after-wedding-planner",
  "version": "1.0.0",
  "private": true,
  "description": "Luxury wedding planning website with an Express and MongoDB API",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node --check backend/server.js && node --check backend/app.js && node --check backend/routes/api.js && node --check public/js/main.js && node --check public/js/api.js",
    "seed": "node backend/scripts/seed.js"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "argon2": "^0.41.1",
    "connect-mongo": "^5.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
